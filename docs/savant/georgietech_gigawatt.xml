<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  RacePoint profile for Gigawatt V2 on a recycled Savant SHC-S2-00.

  Inspector: 192.168.1.142  port 5004  (telnet, CR/LF)
  Wire: TOSLINK optical out of this chassis into the AVR / matrix optical in.

  This is NOT the obsolete SMS-102A profile. No SavantMediaQuery coprocessor,
  no HDMI/VGA, no radio services. Transport + volume only.

  Host telnet tokens (see host-webui/savant.py):
    Play Pause Stop SkipNext SkipPrevious SkipUp SkipDown
    SetVolume <0-50>  SendKeys Volume+  SendKeys Volume-
    Mute  MuteOn  MuteOff  GetStatus  SendKeys Standby
-->
<component xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="racepoint_component_profile.xsd"
    manufacturer="GeorgieTech"
    model="Gigawatt"
    alias="Gigawatt,Gigawatt TOSLINK,GeorgieTech Gigawatt,CRYPT"
    device_class="Media_server"
    minimum_component_engine_version="0.0"
    rpm_xml_version="1.0"
    minimum_compatible_xml_version="1.0">

    <notes>
        Gigawatt local TOSLINK music player (SHC-S2-00 Quad at 192.168.1.142).
        Control is IP telnet port 5004. Audio is optical digital only.
        Not affiliated with Savant Systems. Do not use SMS-102A with this host.
        Version: 1.0 Change: Initial transport + volume. Risk: Low Importance: Critical
    </notes>

    <control_interfaces preferred="ip">
        <ip port="5004" response_time_length_ms="1500" protocol="telnet">
            <send_postfix type="hex">0D0A</send_postfix>
            <receive_end_condition test_condition="data" type="hex">0D0A</receive_end_condition>
        </ip>
    </control_interfaces>

    <media_interfaces>
        <output name_on_component="TOSLINK">
            <audio_media type="optical_digital"></audio_media>
            <resource resource_type="AV_EXTERNALMEDIASERVER_SOURCE"></resource>
            <resource resource_type="AV_VOLUMECONTROL_FUNCTION"></resource>
        </output>
        <data name_on_component="Ethernet">
            <combined_media>
                <data_media type="ethernet"/>
                <control port="5004"/>
            </combined_media>
        </data>
    </media_interfaces>

    <state_variable_list>
        <state_variable name="Power_current_power_setting" owning_logical_component="Media_server" state_center_binding="CurrentPowerStatus" state_center_type="string">ON</state_variable>
        <volume_state_variable name="Volume_current_volume" min_value="0" max_value="50" owning_logical_component="Media_server" state_center_binding="CurrentVolume" granularity="1" state_center_type="string">40</volume_state_variable>
        <state_variable name="Mute_current_mute_setting" owning_logical_component="Media_server" state_center_binding="CurrentMuteStatus" state_center_type="string">OFF</state_variable>
        <state_variable name="Play_current_play_setting" owning_logical_component="Media_server" state_center_binding="CurrentPlayStatus" state_center_type="string">Stop</state_variable>
    </state_variable_list>

    <logical_component logical_component_name="Media_server">
        <implementation>
            <output name_on_component="TOSLINK"></output>
        </implementation>

        <status_messages>
            <status_message name="VolumeStatus">
                <constant type="character">Volume=</constant>
                <data type="character" terminator_type="end_of_data">
                    <update state="CurrentVolume" type="string"></update>
                </data>
            </status_message>
            <status_message name="MuteStatus">
                <constant type="character">Mute=</constant>
                <data type="character" terminator_type="end_of_data">
                    <update state="CurrentMuteStatus" type="string"></update>
                </data>
            </status_message>
            <status_message name="PowerStatus">
                <constant type="character">Power=</constant>
                <data type="character" terminator_type="end_of_data">
                    <update state="CurrentPowerStatus" type="string"></update>
                </data>
            </status_message>
            <status_message name="PlayStatus">
                <constant type="character">Play=</constant>
                <data type="character" terminator_type="end_of_data">
                    <update state="CurrentPlayStatus" type="string"></update>
                </data>
            </status_message>
            <status_message name="TitleStatus">
                <constant type="character">Title=</constant>
                <data type="character" terminator_type="end_of_data">
                    <update state="CurrentSongName" type="string"></update>
                </data>
            </status_message>
            <status_message name="ArtistStatus">
                <constant type="character">Artist=</constant>
                <data type="character" terminator_type="end_of_data">
                    <update state="CurrentArtistName" type="string"></update>
                </data>
            </status_message>
        </status_messages>

        <universal_component_actions>
            <action name="PowerOn">
                <update_state_variable name="Power_current_power_setting" update_type="set" update_source="constant">ON</update_state_variable>
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">GetStatus</command_string>
                        <delay ms_delay="200"></delay>
                    </command>
                </command_interface>
            </action>
            <action name="PowerOff">
                <update_state_variable name="Power_current_power_setting" update_type="set" update_source="constant">OFF</update_state_variable>
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">SendKeys Standby</command_string>
                        <delay ms_delay="200"></delay>
                    </command>
                </command_interface>
            </action>
        </universal_component_actions>

        <resource_component_actions resource_type="AV_VOLUMECONTROL_FUNCTION">
            <action name="SetVolume">
                <action_argument name="VolumeValue" note="0 - 50"/>
                <update_volume_variables name="Volume_current_volume" update_type="set" update_source="action_argument">VolumeValue</update_volume_variables>
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">SetVolume</command_string>
                        <parameter_list>
                            <volume_parameter volume_state_variable="Volume_current_volume" action_argument="VolumeValue" parameter_data_type="character"></volume_parameter>
                        </parameter_list>
                        <delay ms_delay="200"/>
                    </command>
                </command_interface>
            </action>
            <action name="IncreaseVolume">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">SendKeys Volume+</command_string>
                        <delay ms_delay="150"></delay>
                    </command>
                </command_interface>
            </action>
            <action name="DecreaseVolume">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">SendKeys Volume-</command_string>
                        <delay ms_delay="150"></delay>
                    </command>
                </command_interface>
            </action>
            <action name="MuteOn">
                <update_state_variable name="Mute_current_mute_setting" update_type="set" update_source="constant">ON</update_state_variable>
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">MuteOn</command_string>
                        <delay ms_delay="200"></delay>
                    </command>
                </command_interface>
            </action>
            <action name="MuteOff">
                <update_state_variable name="Mute_current_mute_setting" update_type="set" update_source="constant">OFF</update_state_variable>
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">MuteOff</command_string>
                        <delay ms_delay="200"></delay>
                    </command>
                </command_interface>
            </action>
        </resource_component_actions>

        <resource_component_actions resource_type="AV_EXTERNALMEDIASERVER_SOURCE">
            <action name="Play">
                <update_state_variable name="Play_current_play_setting" update_type="set" update_source="constant">Play</update_state_variable>
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">Play</command_string>
                        <delay ms_delay="200"></delay>
                    </command>
                </command_interface>
            </action>
            <action name="Pause">
                <update_state_variable name="Play_current_play_setting" update_type="set" update_source="constant">Pause</update_state_variable>
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">Pause</command_string>
                        <delay ms_delay="200"></delay>
                    </command>
                </command_interface>
            </action>
            <action name="Stop">
                <update_state_variable name="Play_current_play_setting" update_type="set" update_source="constant">Stop</update_state_variable>
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">Stop</command_string>
                        <delay ms_delay="200"></delay>
                    </command>
                </command_interface>
            </action>
            <action name="SkipUp">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">SkipNext</command_string>
                        <delay ms_delay="200"></delay>
                    </command>
                </command_interface>
            </action>
            <action name="SkipDown">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">SkipPrevious</command_string>
                        <delay ms_delay="200"></delay>
                    </command>
                </command_interface>
            </action>
            <action name="ScanUp">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">SendKeys FastForward</command_string>
                        <delay ms_delay="200"></delay>
                    </command>
                </command_interface>
            </action>
            <action name="ScanDown">
                <command_interface interface="ip">
                    <command response_required="no">
                        <command_string type="character">SendKeys Rewind</command_string>
                        <delay ms_delay="200"></delay>
                    </command>
                </command_interface>
            </action>
        </resource_component_actions>
    </logical_component>
</component>
