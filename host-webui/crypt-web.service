[Unit]
Description=Gigawatt V2.2.30 TOSLINK player
After=network-online.target crypt-pulse.service crypt-hostname.service
Wants=network-online.target crypt-pulse.service crypt-hostname.service

[Service]
Type=simple
User=RPM
Group=audio
WorkingDirectory=/data/www
ExecStart=/usr/bin/python3 /data/www/server.py
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
Environment=WEBUI_PORT=80
Environment=MUSIC_DIR=/data/music
Environment=NAS_DIR=/data/nas
Environment=NAS_BIN=/data/opt/nas
Environment=PULSE_SERVER=unix:/var/run/pulse/native
Environment=PULSE_SINK=@DEFAULT_SINK@
EnvironmentFile=-/data/crypt/xai.env

[Install]
WantedBy=multi-user.target
